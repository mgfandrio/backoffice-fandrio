# Adresse de l'API FANDRIO (sans /api à la fin)
VITE_API_URL=http://localhost:8000
# Clé API (la même que l'app mobile : en-tête X-API-KEY)
VITE_API_KEY=
# Temps réel (Laravel Reverb) : mêmes valeurs que REVERB_APP_KEY / REVERB_PUBLIC_* de l'API.
# Sans ces variables, les plans de sièges se rafraîchissent toutes les 5 secondes.
VITE_REVERB_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
